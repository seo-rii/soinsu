FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgmp-dev libmpfr-dev libmpc-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY env/requirements-local.txt /work/env/requirements-local.txt
RUN python3 -m pip install --no-cache-dir -r /work/env/requirements-local.txt
COPY . /work
CMD ["python3", "src/solve7_main.py", "--mode", "analyze"]
